# 복사해서 .env 로 쓰세요 (.env 는 커밋하지 않습니다)

# ---- 저장소 선택 ----
# sqlite  : 로컬 파일 (기본, 로그인 불필요, 인터넷 불필요)
# supabase: 클라우드 Postgres (로그인 필요)
STORAGE=sqlite

# ---- 로컬 SQLite ----
# 상대 경로는 프로젝트 루트 기준.
DB_PATH=db/todo.db

# ---- Flask 웹 화면 ----
# 세션 서명 키. 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---- Supabase (STORAGE=supabase 일 때만 필요) ----
# 대시보드 > Project Settings > API 의 Project URL
SUPABASE_URL=
# 같은 화면의 anon / publishable 키.
#   ✅ sb_publishable_... 또는 eyJ... (가려져 있지 않은 것)
#   ❌ service_role / sb_secret_... / JWT Secret(64자 hex)
# service_role 키는 RLS를 우회하므로 이 앱은 쓰지 않습니다.
# 환경에 SERVICE_ROLE 이름의 변수가 있으면 앱이 시작을 거부합니다.
SUPABASE_ANON_KEY=

# 확인: python3 scripts/check_env.py --connect
